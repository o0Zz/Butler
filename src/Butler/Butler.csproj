<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows (toasts need its SDK) and every other OS; built on macOS or Linux, only the latter -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net9.0-windows10.0.17763.0;net9.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' != 'Windows_NT'">net9.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>butler.ico</ApplicationIcon>
    <!-- Version X.Y.Z.<commits since the beginning>: 0.0.0 for development builds; CI passes 1.0.0 for a tag v1.0.0 -->
    <VersionBase Condition="'$(VersionBase)' == ''">0.0.0</VersionBase>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Avalonia's native control host (the web view) needs the supported OS list -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" Condition="$(TargetFramework.Contains('-windows'))" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="dashboard.html" LogicalName="Butler.dashboard.html" />
    <EmbeddedResource Include="marked.min.js" LogicalName="Butler.marked.min.js" />
    <EmbeddedResource Include="butler.ico" LogicalName="Butler.butler.ico" />
    <EmbeddedResource Include="..\..\docs\butler.svg" LogicalName="Butler.butler.svg" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Butler.Tests" />
  </ItemGroup>

  <!-- The OS services (Platform): Windows' for Windows, macOS' and Linux' for the other target -->
  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <Compile Remove="Platform\Unix\**" />
  </ItemGroup>
  <ItemGroup Condition="!$(TargetFramework.Contains('-windows'))">
    <Compile Remove="Platform\Windows\**" />
  </ItemGroup>

  <!-- The commit count, before the SDK turns Version into the assembly versions (0 without git) -->
  <Target Name="GitVersion" BeforeTargets="GetAssemblyVersion">
    <Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="CommitCount" />
      <Output TaskParameter="ExitCode" PropertyName="GitExit" />
    </Exec>
    <PropertyGroup>
      <CommitCount Condition="'$(GitExit)' != '0'">0</CommitCount>
      <Version>$(VersionBase).$(CommitCount)</Version>
    </PropertyGroup>
  </Target>

</Project>
